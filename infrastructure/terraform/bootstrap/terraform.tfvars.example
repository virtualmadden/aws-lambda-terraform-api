# Copy to terraform.tfvars (gitignored) before the one-time bootstrap apply.
github_repository = "your-org/your-api"
domain_name       = "api.example.com"
hosted_zone_name  = "example.com" # omit when domain_name is the zone itself
# create_github_oidc_provider = false  # if the account already has GitHub's OIDC provider
