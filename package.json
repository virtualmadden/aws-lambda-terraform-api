{
  "name": "aws-lambda-terraform-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/local.ts",
    "build": "tsc && esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --sourcemap --outfile=dist/index.mjs",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "minimatch": "^11.0.1"
  }
}
